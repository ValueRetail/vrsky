# Management API Configuration

# Database Connection
MGMT_API_DB_URL=postgres://vrsky_user:vrsky_pass@postgres:5432/vrsky

# NATS Configuration
MGMT_API_NATS_URL=nats://nats:4222
MGMT_API_NATS_PREFIX=vrsky
MGMT_API_NATS_RECONNECT_MS=100

# HTTP Server
MGMT_API_LISTEN=:3000
MGMT_API_READ_TIMEOUT_SEC=15
MGMT_API_WRITE_TIMEOUT_SEC=30

# CORS Configuration (comma-separated origins)
MGMT_API_CORS_ORIGINS=http://localhost:5173,https://api.vrsky.com

# Multi-tenancy
MGMT_API_TENANT_HEADER=X-Tenant-ID

# Logging
LOG_LEVEL=info

# Service Version
API_VERSION=1.0.0
