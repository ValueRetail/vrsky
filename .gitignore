# ============================================================================
# Environment & Secrets
# ============================================================================
.env
.env.local
.env.*.local
.env.production
.env.staging
*.key
*.pem
*.crt
*.p12
*.pfx

# Kubernetes secrets (never commit!)
**/secret.yaml
**/secret*.yaml
**/secrets/
**/*secret*.yaml
# ...but DO track *.example.yaml templates (placeholder/dev values only, no real creds)
!**/secret.example.yaml
!**/*.example.yaml

# AWS, GCP, Azure credentials
aws_credentials
.aws/
.gcp/
.azure/

# ============================================================================
# IDE / Editor
# ============================================================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-workspace
*.sublime-project
*.iml
.project
.classpath
.c9/
*.jmk
*.ipr
*.iws

# ============================================================================
# Development & Planning Documents
# ============================================================================
# These are temporary development notes, not production documentation
*IMPLEMENTATION*.md
*SUMMARY*.md
*COMPLETE*.md
*IMPLEMENTATION*.txt
*SUMMARY*.txt
NEXT_*.md
QUICK_*.md
*QUICK*.md
*CHECKLIST*.md
*GUIDE*.md
*REFERENCE*.md
*TESTING*.md
*TEST_*.md
*FINAL*.md
*INDEX*.md
FILES_CREATED*.txt

# The ALL-CAPS scratch-note patterns above are for working files, but on
# case-insensitive filesystems (macOS) they also swallow real docs-site pages
# like docs/index.md. Never ignore anything under the published docs tree.
!docs/**

