# ============================================================================
# Go / Binaries
# ============================================================================
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# Dependency directories
vendor/
node_modules/

# ============================================================================
# Build Artifacts & Binaries
# ============================================================================
bin/
*/bin/
**/bin/
dist/
build/
*.o
*.a

# `go build .` inside src/cmd/<name>/ leaves a binary named <name> in that
# directory. One anchored line per command in src/cmd/, so a stray binary is
# ignored and no tracked file is. TestGitignoreCoversCmdBinaries
# (pkg/managementapi) fails when a command is missing here.
/src/cmd/alert-responder/alert-responder
/src/cmd/api-consumer/api-consumer
/src/cmd/bifrost-catalogue-producer/bifrost-catalogue-producer
/src/cmd/brightpearl-consumer/brightpearl-consumer
/src/cmd/brightpearl-producer/brightpearl-producer
/src/cmd/business-central-consumer/business-central-consumer
/src/cmd/business-central-producer/business-central-producer
/src/cmd/cloud-storage-consumer/cloud-storage-consumer
/src/cmd/cloud-storage-producer/cloud-storage-producer
/src/cmd/data-converter/data-converter
/src/cmd/data-filter/data-filter
/src/cmd/db-consumer/db-consumer
/src/cmd/db-producer/db-producer
/src/cmd/example-connector/example-connector
/src/cmd/file-consumer/file-consumer
/src/cmd/file-producer/file-producer
/src/cmd/front-systems-consumer/front-systems-consumer
/src/cmd/front-systems-producer/front-systems-producer
/src/cmd/http-producer/http-producer
/src/cmd/kafka-consumer/kafka-consumer
/src/cmd/kafka-producer/kafka-producer
/src/cmd/lint-connector/lint-connector
/src/cmd/lint-openapi/lint-openapi
/src/cmd/lint-tenant-filter/lint-tenant-filter
/src/cmd/management-api/management-api
/src/cmd/migrate-secrets/migrate-secrets
/src/cmd/mock-sap/mock-sap
/src/cmd/postgres-consumer/postgres-consumer
/src/cmd/postgres-producer/postgres-producer
/src/cmd/rabbitmq-consumer/rabbitmq-consumer
/src/cmd/rabbitmq-producer/rabbitmq-producer
/src/cmd/remote-agent/remote-agent
/src/cmd/salesforce-consumer/salesforce-consumer
/src/cmd/salesforce-producer/salesforce-producer
/src/cmd/sap-s4hana-consumer/sap-s4hana-consumer
/src/cmd/sap-s4hana-producer/sap-s4hana-producer
/src/cmd/sftp-consumer/sftp-consumer
/src/cmd/sftp-producer/sftp-producer
/src/cmd/sitoo-consumer/sitoo-consumer
/src/cmd/sitoo-producer/sitoo-producer
