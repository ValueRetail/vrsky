# Local settings for docker-compose.yml.
#
#   cp .env.example .env     (Windows: copy .env.example .env)
#
# Compose reads .env from this directory on its own; .env is git-ignored.
# Every variable below has a default in docker-compose.yml, and an empty value
# falls back to that default, so an unedited copy starts the same stack as no
# .env at all. Put real values only in .env, never in this file.
#
# The database passwords are not set here. The local stack uses fixed dev
# passwords written into docker-compose.yml and binds its ports to 127.0.0.1.

# Master key for stored secrets (AES-256-GCM): 64 hex characters.
#   openssl rand -hex 32
# Empty means the dev key in docker-compose.yml, which every checkout shares.
# Set your own before you store real credentials and back it up somewhere
# else: changing or losing it makes secrets already stored unreadable.
ENCRYPTION_KEY=

# Shared secret workers present to the OAuth token endpoint.
# Empty means the dev default.
OAUTH_TOKEN_SERVICE_SECRET=

# Bearer token Alertmanager sends to the management API. It must match
# `credentials` in infrastructure/alertmanager.yml, so change both or neither.
# The alert responder reads it too.
ALERTS_WEBHOOK_TOKEN=dev-alerts-webhook-token

# Host folder the file connectors read from, mounted at /data/input in the
# containers. Empty means data/input in this repository. Any path style works:
#   VRSKY_FILES_HOST_DIR=C:\Users\you\vrsky-files   (Windows)
#   VRSKY_FILES_HOST_DIR=/Users/you/vrsky-files      (macOS)
# Each workspace reads from its own subfolder, <folder>/<workspace id>/.
VRSKY_FILES_HOST_DIR=

# Alert responder, off unless you start it:
#   docker compose --profile responder up -d alert-responder
# See docs/operator/alert-responder.md.
ANTHROPIC_API_KEY=
# observe or act
RESPONDER_MODE=observe
# <tenant id>=<workspace API key>, comma-separated
RESPONDER_TENANT_KEYS=
